# Dataset files (large files)
# Keep dataset folders, but ignore their contents
ai-services/*/data/raw/*
ai-services/*/data/processed/*

# Preserve README files in dataset folders
!ai-services/*/data/raw/README.md
!ai-services/*/data/processed/README.md

